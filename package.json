{
  "name": "nestjs-starter",
  "version": "1.4.0-alpha.1",
  "description": "A starter project for NestJS applications using a curated technology stack for optimal performance, reliability, and maintainability.",
  "keywords": [
    "nestjs",
    "typescript",
    "aws-cdk"
  ],
  "author": "LeanStacks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leanstacks/nestjs-starter.git"
  },
  "homepage": "https://github.com/leanstacks/nestjs-starter#readme",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "workspaces": [
    "packages/api",
    "packages/infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "prepare": "husky",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "husky": "9.1.7",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.1"
  },
  "allowScripts": {}
}
