{
  "name": "@nestjs-starter/api",
  "private": true,
  "type": "module",
  "version": "1.4.0-alpha.1",
  "scripts": {
    "build": "nest build",
    "clean": "rimraf coverage dist",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/ --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix src/ test/",
    "test": "vitest run --silent passed-only",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --silent passed-only",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm": "tsx ../../node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- -d src/config/typeorm.config.ts migration:generate",
    "migration:run": "npm run typeorm -- -d src/config/typeorm.config.ts migration:run",
    "migration:revert": "npm run typeorm -- -d src/config/typeorm.config.ts migration:revert",
    "schema:drop": "npm run typeorm -- -d src/config/typeorm.config.ts schema:drop"
  },
  "dependencies": {
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.1",
    "bcrypt": "6.0.0",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.2.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "typeorm": "1.1.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@nestjs/mau": "0.2.8",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "@types/supertest": "7.2.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "tsx": "4.23.15"
  }
}
